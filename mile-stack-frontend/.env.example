# Stellar testnet RPC endpoint
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Deployed MileStack contract ID on testnet
NEXT_PUBLIC_CONTRACT_ID=CAGH37UE6W66FDEI7HPWLGMSWQD4Z7SRZVW3AJLBVL6CUN47UYRUBIFN

# Stellar network passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Native XLM token contract ID on testnet (used for fund_milestone and approve_milestone)
NEXT_PUBLIC_XLM_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# A funded testnet account used as the simulation source for read-only contract calls.
# Generate one at https://stellar.org/laboratory or with: stellar keys generate mykey --network testnet
NEXT_PUBLIC_SIMULATION_SOURCE=

# Supabase - used for off-chain project listings and freelancer applications
# Create a free project at https://supabase.com and copy the URL and anon key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Dev origins
ALLOWED_DEV_ORIGINS=your-allowed-dev-origins # E.g ngrok

# Demo accounts for testing and live presentation (Stellar testnet - no real value)
DEMO_CLIENT_ADDRESS=
DEMO_FREELANCER_ADDRESS=

# E2E integration test keypairs (Stellar testnet - no real value)
# Leave blank to auto-generate random keypairs each run (funded via Friendbot)
# Or provide persistent secrets so balances carry between runs:
#   stellar keys generate client-test --network testnet
INTEGRATION_CLIENT_SECRET=
INTEGRATION_FREELANCER_SECRET=
